{
  "name": "petty-shine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/audit-forbidden.mjs out",
    "postbuild": "[ -n \"$CI\" ] || (rm -rf out.nosync && mv out out.nosync && ln -s out.nosync out)",
    "start": "next start",
    "lint": "eslint",
    "audit": "node scripts/audit-forbidden.mjs out",
    "audit:src": "node scripts/audit-forbidden.mjs src",
    "photos": "python3 scripts/process-photos.py"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
